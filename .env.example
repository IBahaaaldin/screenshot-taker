# Instagram posting (optional — the app works fully without these, the
# gallery's Post buttons will just show "Instagram is not configured"
# until they're set).
#
# See the README's "Instagram posting setup" section for how to obtain
# these from your own Meta developer account.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Hours between each auto-queued post's scheduled time when "Auto-post" is
# checked on a run. N sections queued in one run get spaced this many hours
# apart: the first posts right away and each subsequent one is offset from
# the last, so an N-section site takes roughly (N-1) x SCHEDULE_INTERVAL_HOURS
# for the last item to post after the first.
# A non-numeric or zero value silently falls back to the default of 24 hours.
SCHEDULE_INTERVAL_HOURS=24
